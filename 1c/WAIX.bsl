// Общий модуль WAIX: Сервер = Истина, Вызов сервера = Ложь, Клиент = Ложь.
// 1С:Предприятие 8.3.18+. Сетевые вызовы выполняются фоновым заданием.
// Ключи передаются из защищённых настроек. Код не хранит и не журналирует их.

Функция ОтправитьШаблонWAIX(КлючAPI, ИдентификаторПодключения, Телефон,
    ИмяШаблона, Язык, ЗначениеПеременной, ИдентификаторОперации) Экспорт
    // Обратная совместимость: одна текстовая переменная в теле шаблона.
    Переменные = Новый Массив;
    Переменные.Добавить(ЗначениеПеременной);
    Возврат ОтправитьШаблонСПараметрамиWAIX(КлючAPI, ИдентификаторПодключения,
        Телефон, ИмяШаблона, Язык, Переменные, ИдентификаторОперации);
КонецФункции

Функция ОтправитьШаблонСПараметрамиWAIX(КлючAPI, ИдентификаторПодключения,
    Телефон, ИмяШаблона, Язык, Переменные, ИдентификаторОперации) Экспорт
    ПроверитьUUIDWAIX(ИдентификаторПодключения);
    ПроверитьUUIDWAIX(ИдентификаторОперации);
    Если ПустаяСтрока(ИмяШаблона) Или ПустаяСтрока(Язык) Тогда
        ВызватьИсключение "Укажите имя и язык одобренного шаблона.";
    КонецЕсли;
    ПараметрыТела = Новый Массив;
    Для Каждого Значение Из Переменные Цикл
        ПараметрыТела.Добавить(Новый Структура("type,text", "text", Строка(Значение)));
    КонецЦикла;
    Компоненты = Новый Массив;
    Если ПараметрыТела.Количество() > 0 Тогда
        Компоненты.Добавить(Новый Структура("type,parameters", "body", ПараметрыТела));
    КонецЕсли;
    Шаблон = Новый Структура("name,language,components", ИмяШаблона,
        Новый Структура("code", Язык), Компоненты);
    Данные = Новый Структура("connection_id,to,type,template",
        Строка(ИдентификаторПодключения), ТелефонE164WAIX(Телефон), "template", Шаблон);
    Возврат ЗапросWAIX(КлючAPI, "POST", "/messages", Данные, Строка(ИдентификаторОперации));
КонецФункции

Функция СтатусСообщенияWAIX(КлючAPI, ИдентификаторСообщения) Экспорт
    ПроверитьUUIDWAIX(ИдентификаторСообщения);
    Возврат ЗапросWAIX(КлючAPI, "GET", "/messages/" + Строка(ИдентификаторСообщения));
КонецФункции

Функция ОтправитьOTPWAIX(КлючПроекта, Телефон, ИдентификаторОперации, СрокСекунд = 300) Экспорт
    ПроверитьUUIDWAIX(ИдентификаторОперации);
    Если ТипЗнч(СрокСекунд) <> Тип("Число") Тогда
        ВызватьИсключение "Срок кода должен быть числом секунд.";
    КонецЕсли;
    Если СрокСекунд < 60 Или СрокСекунд > 600 Или Цел(СрокСекунд) <> СрокСекунд Тогда
        ВызватьИсключение "Срок кода - целое число от 60 до 600 секунд.";
    КонецЕсли;
    Данные = Новый Структура("to,channel,ttl", ТелефонE164WAIX(Телефон), "whatsapp", СрокСекунд);
    Возврат ЗапросWAIX(КлючПроекта, "POST", "/otp/send", Данные, Строка(ИдентификаторОперации));
КонецФункции

Функция ПроверитьOTPWAIX(КлючПроекта, ИдентификаторЗапроса, Код) Экспорт
    ПроверитьUUIDWAIX(ИдентификаторЗапроса);
    Если ТипЗнч(Код) <> Тип("Строка") Тогда
        ВызватьИсключение "Код должен быть строкой, чтобы сохранить начальные нули.";
    КонецЕсли;
    Если СтрДлина(Код) <> 6 Или Не ТолькоЦифрыWAIX(Код) Тогда
        ВызватьИсключение "Код должен содержать ровно шесть цифр.";
    КонецЕсли;
    Данные = Новый Структура("id,code", Строка(ИдентификаторЗапроса), Код);
    Возврат ЗапросWAIX(КлючПроекта, "POST", "/otp/verify", Данные);
КонецФункции

Функция СтатусOTPWAIX(КлючПроекта, ИдентификаторЗапроса) Экспорт
    ПроверитьUUIDWAIX(ИдентификаторЗапроса);
    Возврат ЗапросWAIX(КлючПроекта, "GET", "/otp/" + Строка(ИдентификаторЗапроса));
КонецФункции

Функция ЗапросWAIX(КлючAPI, Метод, Путь, Данные = Неопределено, КлючИдемпотентности = "")
    Если ПустаяСтрока(КлючAPI) Или СтрНайти(КлючAPI, Символы.ПС) > 0
        Или СтрНайти(КлючAPI, Символы.ВК) > 0 Тогда
        ВызватьИсключение "Не задан корректный серверный ключ WAIX.";
    КонецЕсли;
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
    Заголовки.Вставить("Accept", "application/json");
    Заголовки.Вставить("User-Agent", "waix-1c/0.2.0");
    Если Не ПустаяСтрока(КлючИдемпотентности) Тогда
        ПроверитьUUIDWAIX(КлючИдемпотентности);
        Заголовки.Вставить("Idempotency-Key", КлючИдемпотентности);
    КонецЕсли;
    Запрос = Новый HTTPЗапрос("/api/v1" + Путь, Заголовки);
    Если Данные <> Неопределено Тогда
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        ЗаписатьJSON(Запись, Данные);
        Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8,
            ИспользованиеByteOrderMark.НеИспользовать);
    КонецЕсли;
    Результат = Новый Структура("Успех,КодСостояния,Данные,Ошибка,RequestID,RetryAfter,Тело",
        Ложь, 0, Неопределено, "", "", "", "");
    Попытка
        TLS = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
        Соединение = Новый HTTPСоединение("waix.kz", 443, , , , 30, TLS);
        Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
        Результат.КодСостояния = Ответ.КодСостояния;
        Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
        Для Каждого Заголовок Из Ответ.Заголовки Цикл
            Если НРег(Заголовок.Ключ) = "x-request-id" Тогда
                Результат.RequestID = Заголовок.Значение;
            КонецЕсли;
            Если НРег(Заголовок.Ключ) = "retry-after" Тогда
                Результат.RetryAfter = Заголовок.Значение;
            КонецЕсли;
        КонецЦикла;
    Исключение
        // ОписаниеОшибки() может содержать URL и служебные данные. Не возвращаем его в форму.
        Результат.Ошибка = "TRANSPORT_ERROR";
        Возврат Результат;
    КонецПопытки;
    Возврат РазобратьОтветWAIX(Результат);
КонецФункции

Функция РазобратьОтветWAIX(Результат)
    Если Результат.КодСостояния >= 300 И Результат.КодСостояния < 400 Тогда
        Результат.Ошибка = "REDIRECT_DISALLOWED";
        Возврат Результат;
    КонецЕсли;
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Результат.Тело);
        Объект = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
        Если ТипЗнч(Объект) <> Тип("Соответствие") Тогда
            ВызватьИсключение "Ответ не является объектом JSON.";
        КонецЕсли;
        Результат.Данные = Объект.Получить("data");
        Если Объект.Получить("request_id") <> Неопределено Тогда
            Результат.RequestID = Объект.Получить("request_id");
        КонецЕсли;
        Результат.Успех = Результат.КодСостояния >= 200 И Результат.КодСостояния < 300;
        Если Не Результат.Успех Тогда
            Результат.Ошибка = Объект.Получить("code");
            Если Результат.Ошибка = Неопределено Тогда
                Результат.Ошибка = "API_ERROR";
            КонецЕсли;
        КонецЕсли;
    Исключение
        Результат.Ошибка = "INVALID_RESPONSE";
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция ПроверитьUUIDWAIX(Значение)
    Попытка
        Возврат Новый УникальныйИдентификатор(Строка(Значение));
    Исключение
        ВызватьИсключение "Ожидается UUID. Сохраните его до первого запроса и используйте при повторе.";
    КонецПопытки;
КонецФункции

Функция ТолькоЦифрыWAIX(Значение)
    Для Позиция = 1 По СтрДлина(Значение) Цикл
        Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат СтрДлина(Значение) > 0;
КонецФункции

Функция ТелефонE164WAIX(Значение) Экспорт
    Телефон = СокрЛП(Строка(Значение));
    Телефон = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Телефон, " ", ""), "(", ""), ")", ""), "-", "");
    Если СтрДлина(Телефон) = 11 И Лев(Телефон, 1) = "8" Тогда
        Телефон = "7" + Сред(Телефон, 2);
    КонецЕсли;
    Если СтрДлина(Телефон) = 11 И Лев(Телефон, 1) = "7" Тогда
        Телефон = "+" + Телефон;
    КонецЕсли;
    Если Лев(Телефон, 1) <> "+" Или СтрДлина(Телефон) < 9 Или СтрДлина(Телефон) > 16
        Или Сред(Телефон, 2, 1) = "0" Или Не ТолькоЦифрыWAIX(Сред(Телефон, 2)) Тогда
        ВызватьИсключение "Нужен телефон с кодом страны, например +77071234567.";
    КонецЕсли;
    Возврат Телефон;
КонецФункции
