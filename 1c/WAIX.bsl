// Общий модуль на сервере. Ключ храните в защищённых настройках, а не в форме.
// ИдентификаторОперации — UUID, сохранённый в регистре исходящих уведомлений.
// При повторе передайте тот же UUID и те же параметры.
Функция ОтправитьШаблонWAIX(КлючAPI, ИдентификаторПодключения, Телефон,
    ИмяШаблона, Язык, ЗначениеПеременной, ИдентификаторОперации) Экспорт

    ПараметрыТела = Новый Массив;
    ПараметрыТела.Добавить(Новый Структура("type,text", "text", ЗначениеПеременной));
    Компоненты = Новый Массив;
    Компоненты.Добавить(Новый Структура("type,parameters", "body", ПараметрыТела));
    Шаблон = Новый Структура("name,language,components", ИмяШаблона,
        Новый Структура("code", Язык), Компоненты);
    Данные = Новый Структура("connection_id,to,type,template",
        ИдентификаторПодключения, Телефон, "template", Шаблон);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();

    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + КлючAPI);
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Заголовки.Вставить("Accept", "application/json");
    Заголовки.Вставить("Idempotency-Key", Строка(ИдентификаторОперации));
    Запрос = Новый HTTPЗапрос("/api/v1/messages", Заголовки);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8,
        ИспользованиеByteOrderMark.НеИспользовать);
    TLS = Новый ЗащищенноеСоединениеOpenSSL(,
        Новый СертификатыУдостоверяющихЦентровОС);
    Соединение = Новый HTTPСоединение("waix.kz", 443, , , , 30, TLS);
    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    // Верните HTTP-код вызывающему обработчику. 202 означает очередь, не доставку.
    // При сетевом исключении не создавайте новый ИдентификаторОперации.
    Возврат Новый Структура("КодСостояния,Тело", Ответ.КодСостояния,
        Ответ.ПолучитьТелоКакСтроку());
КонецФункции
