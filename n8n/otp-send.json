      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst invalid = error => [{json:{valid:false,error}}];\nconst uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i;\nif (!uuid.test(b.event_id || '')) return invalid('event_id должен быть UUID, сохранённым вашим сервером для этой отправки.');\nif (!/^\\+[1-9]\\d{7,14}$/.test(b.phone || '')) return invalid('Номер должен быть в формате E.164, например +77071234567.');\nreturn [{json:{valid:true,idempotency_key:b.event_id,body:{to:b.phone,channel:'whatsapp',ttl:300}}}];"
      }
    },
    {
      "id": "c2f01909-2785-4c10-bc0d-f2d1f7c4b578",
