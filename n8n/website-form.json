      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst invalid = error => [{json:{valid:false,error}}];\nconst uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i;\n// Replace connection and template below with your own approved template.\nconst connectionId = 'REPLACE_CONNECTION_ID';\nconst templateName = 'your_approved_template';\nconst language = 'ru';\nif (!uuid.test(connectionId)) return invalid('Настройте Connection ID в узле Prepare request.');\nif (!uuid.test(b.event_id || '')) return invalid('event_id должен быть UUID, сохранённым вашим сервером для этой отправки.');\nif (!/^\\+[1-9]\\d{7,14}$/.test(b.phone || '')) return invalid('Номер должен быть в формате E.164.');\nif (b.whatsapp_consent !== true) return invalid('Нет подтверждения согласия клиента на сообщения WhatsApp.');\nif (typeof b.name !== 'string' || !b.name.trim() || b.name.length > 500) return invalid('Заполните поле name, до 500 символов.');\nreturn [{json:{valid:true,idempotency_key:b.event_id,body:{connection_id:connectionId,to:b.phone,type:'template',template:{name:templateName,language:{code:language},components:[{type:'body',parameters:[{type:'text',text:b.name}]}]}}}}];"
      }
    },
