        "jsCode": "const b = $json.body || {};\nconst invalid = error => [{json:{valid:false,error}}];\nconst uuid = /^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i;\nif (!uuid.test(b.id || '') || !/^\\d{6}$/.test(b.code || '')) return invalid('Укажите id запроса и шестизначный код.');\nreturn [{json:{valid:true,body:{id:b.id,code:b.code}}}];"
      }
    },
